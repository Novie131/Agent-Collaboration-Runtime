{
  "name": "agent-collaboration-runtime",
  "version": "0.1.0",
  "description": "ACR: a local, token-aware hub through which ChatGPT and Claude Code exchange tasks, results, evidence and decisions.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:core": "node scripts/check-core-imports.mjs",
    "acr": "node apps/cli/dist/cli.js",
    "fixtures:jest": "node scripts/capture-jest-fixtures.mjs"
  },
  "devDependencies": {
    "@acr/artifacts": "workspace:*",
    "@acr/benchmark": "workspace:*",
    "@acr/cli": "workspace:*",
    "@acr/compression": "workspace:*",
    "@acr/core": "workspace:*",
    "@acr/git": "workspace:*",
    "@acr/mcp": "workspace:*",
    "@acr/platform": "workspace:*",
    "@acr/protocol": "workspace:*",
    "@acr/runner": "workspace:*",
    "@acr/security": "workspace:*",
    "@acr/storage": "workspace:*",
    "@acr/telemetry": "workspace:*",
    "@acr/transcripts": "workspace:*",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "zod": "^3.23.8"
  }
}
